# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# macOS
.DS_Store
.ipynb_checkpoints/

# Run outputs: weights, run directories, and mutable latest pointers.
# A curated reference run is committed under docs/reference-run/ instead.
*.safetensors
*.tmp
artifacts/qwen2.5-*/
artifacts/custom/
artifacts/toy/
artifacts/historical/**/fused_model/
artifacts/historical/qwen2.5-14b/
artifacts/historical/qwen2.5-32b/

# Share only portable Entire settings/hooks; keep other agent state local.
!/.agents/
/.agents/*
!/.agents/hooks.json
!/.claude/
/.claude/*
!/.claude/settings.json
!/.codex/
/.codex/*
!/.codex/hooks.json
!/.opencode/
/.opencode/*
!/.opencode/plugins/
/.opencode/plugins/*
!/.opencode/plugins/entire.ts

# Entire's nested ignore file excludes its runtime data and personal settings.
!/.entire/
/.entire/*
!/.entire/.gitignore
!/.entire/settings.json
!/.entire/redactors/
