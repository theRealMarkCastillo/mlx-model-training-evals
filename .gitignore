# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# macOS
.DS_Store
.ipynb_checkpoints/

# Run outputs: weights, run directories, and mutable latest pointers.
# A curated reference run is committed under docs/reference-run/ instead.
*.safetensors
*.tmp
artifacts/qwen2.5-*/
artifacts/custom/
artifacts/toy/
artifacts/historical/**/fused_model/
artifacts/historical/qwen2.5-14b/
artifacts/historical/qwen2.5-32b/

# Keep machine-specific configuration and generated local artifacts out of Git.
/.agents/*.json
/.claude/*.json
/.codex/*.json
/.entire/*.json
